# .build/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Training/validation run outputs (regenerable via ultralytics val/predict)
runs/

# YOLO label caches (regenerated automatically)
*.cache

# Recorded video clips (dev testing / dashcam output) — large binaries, not code
*.mov

# Packaged session data (raw + annotated recordings, detections/logs, benchmarks)
/data/

# Pulled device logs (regenerable via tools/pull_logs.sh)
/logs/

# Stock pretrained YOLO checkpoints (unused .pt originals + benchmark.py's reference
# model) -- not referenced by the app (which bundles the converted .mlpackage files
# instead) or any checked-in conversion script; auto-downloadable via ultralytics
/*.pt
