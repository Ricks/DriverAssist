# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode
build/
DerivedData/
DriverAssist/build_output/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.dSYM
*.dSYM.zip
*.hmap
